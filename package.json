{
  "name": "action-register",
  "productName": "Action Register",
  "version": "1.1.0",
  "private": true,
  "description": "Email-to-task manager for mechanical / water & wastewater engineers: imports Outlook emails with attachments, Claude extracts evidence-backed tasks, user approves, tasks shown as a Project → Topic → Task mind map.",
  "scripts": {
    "build": "node build.js",
    "build:desktop": "node build.js desktop",
    "start": "node build.js desktop && electron .",
    "dist": "node build.js desktop && electron-builder",
    "dist:win": "node build.js desktop && electron-builder --win",
    "dist:mac": "node build.js desktop && electron-builder --mac",
    "dist:linux": "node build.js desktop && electron-builder --linux",
    "test:unit": "node test/unit/parse.test.js && node test/unit/ai.test.js && node test/unit/wb.test.js",
    "test:desktop": "node build.js desktop && node test/desktop/e2e.js",
    "test:e2e": "python3 test/e2e_final.py && python3 test/e2e_gmail.py && python3 test/e2e_3d.py && python3 test/e2e_map.py && python3 test/e2e_canvas.py && python3 test/e2e_work.py && python3 test/e2e_tools.py && python3 test/e2e_workbooks.py && python3 test/e2e_money.py && python3 test/e2e_notebook.py"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "docx": "8.5.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "exceljs": "4.4.0",
    "hoodiecrow-imap": "3.3.1",
    "jszip": "3.10.1",
    "mammoth": "1.8.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "playwright": "1.63.0",
    "xlsx": "0.18.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "electron-updater": "6.8.10",
    "imapflow": "1.7.8"
  },
  "main": "desktop/main.js",
  "author": "Mahmoud Sobeah",
  "build": {
    "appId": "com.msobeah.actionregister",
    "productName": "Action Register",
    "artifactName": "Action-Register-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Action-Register-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Action-Register-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mooody147",
        "repo": "ahmed",
        "releaseType": "release"
      }
    ]
  }
}
